# RRBA — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — from your project's API settings
# ---------------------------------------------------------------------------

# Safe to expose to the browser (NEXT_PUBLIC_ prefix ships in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely.
# Never prefix with NEXT_PUBLIC_ and never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Used to build auth redirect and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First-admin bootstrap. Server only — do not prefix with NEXT_PUBLIC_.
#
# Set this to the email you will sign up with. That account can then claim
# super admin from the dashboard once, without any manual SQL.
#
# Leaving it blank disables the bootstrap entirely, which is the safe default:
# a deployment that grants admin to whoever signs up first is a race against
# strangers on a public URL. The claim also stops working permanently as soon
# as one active super admin exists.
BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Reserved for later milestones — leave blank until then
# ---------------------------------------------------------------------------

# M10 — M-Pesa (Safaricom Daraja). Server only.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_ENVIRONMENT=sandbox

# M10 — Notifications. Server only.
# RESEND_API_KEY=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
