# RRBA — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — from your project's API settings
# ---------------------------------------------------------------------------

# Safe to expose to the browser (NEXT_PUBLIC_ prefix ships in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely.
# Never prefix with NEXT_PUBLIC_ and never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Used to build auth redirect and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Reserved for later milestones — leave blank until then
# ---------------------------------------------------------------------------

# M10 — M-Pesa (Safaricom Daraja). Server only.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_ENVIRONMENT=sandbox

# M10 — Notifications. Server only.
# RESEND_API_KEY=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
